DATABASE_URL=file:./data/harmos.db
AI_BASE_URL=https://api.meta.ai/v1
AI_API_KEY=your_key_here
AI_MODEL=muse-spark-1.3
HARMOS_CACHE_DIR=./.cache
HARMOS_DEMO_MODE=0
HARMOS_UPLOAD_DIR=./data/uploads
HARMOS_CATALOG_ADAPTER=local
# Session signing secret. Optional: when unset, a random secret is generated
# on each boot (everyone is logged out on restart).
HARMOS_SESSION_SECRET=
# Distributor imports (LCSC first; more distributors to follow the same pattern).
# Keys are optional: with them the signed official API is used; without them
# the throttled public community search is used instead.
# Apply for a key via support@lcsc.com — see README "Distributor imports".
LCSC_API_KEY=
LCSC_API_SECRET=
LCSC_API_BASE_URL=https://api.lcsc.com
