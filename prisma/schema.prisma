// Harmos data model
// SQLite via Prisma. Every record except Project, CatalogPart, and User
// belongs to a Project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Local account. Passwords are stored as scrypt hashes, never plaintext.
/// The first account is created through /signup; login is always required.
model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  projects Project[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  brief     String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements          Requirement[]
  resources             Resource[]
  components            Component[]
  componentLinks        ComponentArtifactLink[]
  comparisonConstraints ComparisonConstraint[]
  comparisonRuns        ComparisonRun[]
  comparisonCandidates  ComparisonCandidate[]
  artifacts             Artifact[]
  edges                 Edge[]
  decisions             Decision[]
  validationTests       ValidationTest[]

  /// Owner account. Null = shared (seed demo, legacy rows): visible to all
  /// signed-in users. Set on creation for everything new.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
}

/// A global, locally seeded component catalog. Unlike project data, catalog
/// rows are not owned by a project and are replaced by the seed.
model CatalogPart {
  id                String   @id
  partNumber        String   @unique
  manufacturer      String
  category          String
  description       String
  package           String
  datasheetUrl      String
  sourceUrl         String
  sourceRetrievedAt DateTime
  priceUsd          Float?
  specsJson         String
  tags              String

  /// Where the row came from: seeded (ship list), imported (CSV), or custom
  /// (added in the UI). The seed only fills gaps and never overwrites rows.
  origin String @default("seeded")

  @@index([category])
  @@index([manufacturer])
}

/// An AI-drafted catalog entry waiting for human review. Nothing here is in
/// the catalog yet: approving validates once more and creates the CatalogPart
/// (origin "agent"); rejecting deletes the row.
model CatalogProposal {
  id          String   @id @default(cuid())
  status      String   @default("pending")
  source      String   @default("ai")
  request     String
  payloadJson String
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@index([status])
}

/// A deterministic constraint used to score catalog candidates. Values are
/// JSON-encoded so a constraint can compare numbers or strings/arrays.
model ComparisonConstraint {
  id        String  @id @default(cuid())
  projectId String
  label     String
  metric    String
  operator  String
  valueJson String
  unit      String?
  kind      String
  position  Int     @default(0)

  /// Catalog categories this constraint applies to, as JSON. Empty means all.
  appliesToJson String @default("[]")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// One scored comparison. A run snapshots the constraints and the AI prose so
/// previous results remain reproducible after a project changes.
model ComparisonRun {
  id                String   @id @default(cuid())
  projectId         String
  category          String
  summary           String
  explanationStatus String
  constraintsJson   String
  createdAt         DateTime @default(now())

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  candidates ComparisonCandidate[]

  @@index([projectId])
}

model Requirement {
  id        String @id @default(cuid())
  projectId String
  text      String
  kind      String
  status    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Resource {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  url         String
  kind        String
  summary     String
  retrievedAt DateTime
  tags        String

  /// Whether the latest selection (AI or manual) includes this row, and why.
  selected      Boolean @default(false)
  selectionNote String  @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Component {
  id             String  @id @default(cuid())
  projectId      String
  partNumber     String
  manufacturer   String
  package        String
  datasheetUrl   String?
  notes          String?
  quantity       Int     @default(1)
  unitPriceCents Int?

  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifactLinks ComponentArtifactLink[]

  @@index([projectId])
}

/// An explicit dependency from a selected component to an artifact it feeds.
/// Component swaps traverse these links first, then artifact-to-artifact edges.
model ComponentArtifactLink {
  id          String @id @default(cuid())
  projectId   String
  componentId String
  artifactId  String
  kind        String

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  artifact  Artifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([componentId, artifactId, kind])
  @@index([projectId])
  @@index([componentId])
  @@index([artifactId])
}

model ComparisonCandidate {
  id                    String  @id @default(cuid())
  projectId             String
  runId                 String?
  catalogPartId         String?
  partNumber            String
  manufacturer          String
  dataJson              String
  verdict               String
  reason                String
  score                 Int     @default(0)
  constraintResultsJson String  @default("[]")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     ComparisonRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([runId])
}

model Artifact {
  id        String @id @default(cuid())
  projectId String
  kind      String
  name      String
  version   String
  metaJson  String

  /// Content fingerprint when known; blank for hand-entered rows until file
  /// hashing lands. Preserved on update, never required.
  hash String @default("")

  /// The current version of its (project, kind, name) family. At most one
  /// per family; enforced in the set-current action, not the database.
  current Boolean @default(false)

  /// Uploaded file metadata. Bytes live under HARMOS_UPLOAD_DIR, never in SQLite.
  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edgesFrom      Edge[]                  @relation("EdgeFrom")
  edgesTo        Edge[]                  @relation("EdgeTo")
  componentLinks ComponentArtifactLink[]

  @@index([projectId])
}

model Edge {
  id             String @id @default(cuid())
  projectId      String
  fromArtifactId String
  toArtifactId   String
  kind           String

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromArtifact Artifact @relation("EdgeFrom", fields: [fromArtifactId], references: [id], onDelete: Cascade)
  toArtifact   Artifact @relation("EdgeTo", fields: [toArtifactId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fromArtifactId])
  @@index([toArtifactId])
}

model Decision {
  id        String   @id @default(cuid())
  projectId String
  title     String
  rationale String
  decidedAt DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ValidationTest {
  id        String @id @default(cuid())
  projectId String
  name      String
  status    String
  notes     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
